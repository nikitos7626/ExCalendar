TELEGRAM_BOT_TOKEN=your_bot_token_here
# Тренеры: по Telegram ID и/или по @username (достаточно одного из вариантов)
INSTRUCTOR_CHAT_ID=your_telegram_id_here
# Или по нику без @: INSTRUCTOR_USERNAMES=nikit,coach (несколько через запятую)
# INSTRUCTOR_USERNAMES=nikit
DATABASE_URL=mysql://user:password@host:3306/excalendar
BOT_USERNAME=IndividTrainBot
TIMEZONE=Europe/Moscow
WORKING_DAYS=mon,tue,wed,thu,fri
WORK_START_HOUR=8
WORK_END_HOUR=22
BOOKING_HORIZON_DAYS=30
# За сколько минут до тренировки напоминать тренеру (1–120, по умолчанию 15)
TRAINER_REMINDER_MINUTES=15

